[name=vector_encode_mismatched_dims_safe]
[required_features=VECTOR_TYPE,DECLARATIVE_TYPE_FRAMEWORK,SAFE_FUNCTION_CALL]
SELECT VECTOR_DIMENSION_COUNT(SAFE.ENCODE_VECTOR(ARRAY<FLOAT>[1.0, 2.0, 3.0], 2));
