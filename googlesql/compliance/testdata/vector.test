##############################
# QUERIES ON PREPARED TABLES #
##############################

[name=query_vector_table_unannotated_column]
SELECT id, VECTOR_DIMENSION_COUNT(v_unannotated), DECODE_VECTOR(v_unannotated)
FROM VectorTable
ORDER BY id;
--
ARRAY<STRUCT<id INT64, INT64, ARRAY<>>>[known order:
  {
    1,
    3,
    ARRAY<FLOAT>[known order:1, 2, 3]
  },
  {
    2,
    2,
    ARRAY<FLOAT>[known order:4, 5]
  }
]
==

[name=query_vector_table_param_column]
SELECT id, VECTOR_DIMENSION_COUNT(v_len2), DECODE_VECTOR(v_len2)
FROM VectorTable
ORDER BY id;
--
ARRAY<STRUCT<id INT64, INT64, ARRAY<>>>[known order:
  {
    1,
    2,
    ARRAY<FLOAT>[known order:1, 2]
  },
  {
    2,
    2,
    ARRAY<FLOAT>[known order:0, 1]
  }
]
==

[name=query_vector_table_array_column]
SELECT id, ARRAY_LENGTH(v_arr), VECTOR_DIMENSION_COUNT(v_arr[OFFSET(0)])
FROM VectorTable
ORDER BY id;
--
ARRAY<STRUCT<id INT64, INT64, INT64>>[known order:{1, 2, 2}, {2, 1, 2}]
==

[name=query_vector_table_unannotated_array_column]
SELECT id, ARRAY_LENGTH(v_arr_unannotated), VECTOR_DIMENSION_COUNT(v_arr_unannotated[OFFSET(0)]), VECTOR_DIMENSION_COUNT(v_arr_unannotated[OFFSET(1)])
FROM VectorTable
WHERE id = 1;
--
ARRAY<STRUCT<id INT64, INT64, INT64, INT64>>[{1, 2, 2, 3}]
==

[name=query_vector_table_struct_column]
SELECT id, VECTOR_DIMENSION_COUNT(v_struct.a), DECODE_VECTOR(v_struct.a)
FROM VectorTable
ORDER BY id;
--
ARRAY<STRUCT<id INT64, INT64, ARRAY<>>>[known order:
  {
    1,
    2,
    ARRAY<FLOAT>[known order:1, 2]
  },
  {
    2,
    2,
    ARRAY<FLOAT>[known order:0, 1]
  }
]
==

[name=query_vector_table_distance_functions]
