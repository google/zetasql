[name=vector_encode_mismatched_dims]
SELECT VECTOR_DIMENSION_COUNT(ENCODE_VECTOR(ARRAY<FLOAT>[1.0, 2.0, 3.0], 2));
--
ERROR: generic::out_of_range: Input ARRAY does not have a matching array_length (3) with the dims (2)
