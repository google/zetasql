[prepare_database]
[default required_features=VECTOR_TYPE,DECLARATIVE_TYPE_FRAMEWORK]
[prepare_database_additional_features=VECTOR_TYPE,DECLARATIVE_TYPE_FRAMEWORK]
CREATE TEMP CONSTANT CVectorDims = 2;
==

#######
# DDL #
#######
[prepare_database]
[prepare_database_additional_features=VECTOR_TYPE,DECLARATIVE_TYPE_FRAMEWORK]
# TODO: Add standalone failing tests for CREATE TABLE with VECTOR types.
CREATE TABLE VectorTable(
  id INT64,
  v_unannotated VECTOR,
  v_len2 VECTOR(2),
  v_arr ARRAY<VECTOR(2)>,
  v_arr_unannotated ARRAY<VECTOR>,
  v_struct STRUCT<a VECTOR(2)>) AS
SELECT
  1 AS id,
  ENCODE_VECTOR(ARRAY<FLOAT>[1.0, 2.0, 3.0]) AS v_unannotated,
  ENCODE_VECTOR(ARRAY<FLOAT>[1.0, 2.0]) AS v_len2,
  ARRAY<VECTOR>[ENCODE_VECTOR(ARRAY<FLOAT>[1.0, 2.0]), ENCODE_VECTOR(ARRAY<FLOAT>[3.0, 4.0])] AS v_arr,
  ARRAY<VECTOR>[ENCODE_VECTOR(ARRAY<FLOAT>[1.0, 2.0]), ENCODE_VECTOR(ARRAY<FLOAT>[3.0, 4.0, 5.0])] AS v_arr_unannotated,
  STRUCT(ENCODE_VECTOR(ARRAY<FLOAT>[1.0, 2.0]) AS a) AS v_struct
UNION ALL
SELECT
  2 AS id,
  ENCODE_VECTOR(ARRAY<FLOAT>[4.0, 5.0]) AS v_unannotated,
  ENCODE_VECTOR(ARRAY<FLOAT>[0.0, 1.0]) AS v_len2,
  ARRAY<VECTOR>[ENCODE_VECTOR(ARRAY<FLOAT>[5.0, 6.0])] AS v_arr,
  ARRAY<VECTOR>[ENCODE_VECTOR(ARRAY<FLOAT>[5.0, 6.0])] AS v_arr_unannotated,
  STRUCT(ENCODE_VECTOR(ARRAY<FLOAT>[0.0, 1.0]) AS a) AS v_struct
--
ARRAY<STRUCT<
        id INT64,
        v_unannotated VECTOR,
        v_len2 VECTOR,
        v_arr ARRAY<>,
        v_arr_unannotated ARRAY<>,
        v_struct STRUCT<a VECTOR>
      >>
[{
   1,
   VECTOR([1, 2, 3]),
   VECTOR([1, 2]),
   ARRAY<VECTOR>[VECTOR([1, 2]), VECTOR([3, 4])],
   ARRAY<VECTOR>[VECTOR([1, 2]), VECTOR([3, 4, 5])],
   {VECTOR([1, 2])}
 },
 {
   2,
   VECTOR([4, 5]),
   VECTOR([0, 1]),
   ARRAY<VECTOR>[VECTOR([5, 6])],
   ARRAY<VECTOR>[VECTOR([5, 6])],
   {VECTOR([0, 1])}
 }]
==

[prepare_database]
[prepare_database_additional_features=VECTOR_TYPE,DECLARATIVE_TYPE_FRAMEWORK]
CREATE TABLE VectorDmlTable(
  id INT64,
  v VECTOR(2)) AS
SELECT 1 AS id, ENCODE_VECTOR(ARRAY<FLOAT>[1.0, 2.0]) AS v
--
ARRAY<STRUCT<id INT64, v VECTOR>>[{1, VECTOR([1, 2])}]
==


#################
# ENCODE_VECTOR #
#################

[name=vector_encode_empty]
SELECT VECTOR_DIMENSION_COUNT(ENCODE_VECTOR(ARRAY<FLOAT>[]));
--
ERROR: generic::out_of_range: The input ARRAY to ENCODE_VECTOR must not be empty
==

[name=vector_encode_parameter_and_constant]
[parameters=ARRAY<FLOAT>[1.0, 2.0] as param_arr]
SELECT VECTOR_DIMENSION_COUNT(ENCODE_VECTOR(@param_arr, CVectorDims));
--
ARRAY<STRUCT<INT64>>[{2}]
==

[name=vector_encode_null_error]
SELECT VECTOR_DIMENSION_COUNT(ENCODE_VECTOR(ARRAY<FLOAT>[1.0, NULL]));
--
ERROR: generic::out_of_range: NULL values are not permitted in ENCODE_VECTOR
==

[name=vector_encode_null_error_safe]
[required_features=VECTOR_TYPE,DECLARATIVE_TYPE_FRAMEWORK,SAFE_FUNCTION_CALL]
SELECT VECTOR_DIMENSION_COUNT(SAFE.ENCODE_VECTOR(ARRAY<FLOAT>[1.0, NULL]));
--
ARRAY<STRUCT<INT64>>[{NULL}]
==

[name=vector_encode_nan_error]
SELECT VECTOR_DIMENSION_COUNT(ENCODE_VECTOR(ARRAY<FLOAT>[1.0, CAST('NaN' AS FLOAT)]));
--
ERROR: generic::out_of_range: NaN, +inf, or -inf values are not permitted in ENCODE_VECTOR
==

[name=vector_encode_nan_error_safe]
[required_features=VECTOR_TYPE,DECLARATIVE_TYPE_FRAMEWORK,SAFE_FUNCTION_CALL]
SELECT VECTOR_DIMENSION_COUNT(SAFE.ENCODE_VECTOR(ARRAY<FLOAT>[1.0, CAST('NaN' AS FLOAT)]));
--
ARRAY<STRUCT<INT64>>[{NULL}]
==

[name=vector_encode_inf_error]
SELECT VECTOR_DIMENSION_COUNT(ENCODE_VECTOR(ARRAY<FLOAT>[1.0, CAST('+inf' AS FLOAT)]));
--
ERROR: generic::out_of_range: NaN, +inf, or -inf values are not permitted in ENCODE_VECTOR
==

[name=vector_encode_inf_error_safe]
[required_features=VECTOR_TYPE,DECLARATIVE_TYPE_FRAMEWORK,SAFE_FUNCTION_CALL]
