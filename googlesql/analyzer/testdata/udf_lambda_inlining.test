[use_database=udf_db_with_apply_int]
[prepare_database=udf_db_propagation]
CREATE FUNCTION propagate_int(f FUNCTION<INT64 -> INT64>, x INT64) AS (apply_int(FUNCTION f, x));
--

CreateFunctionStmt
+-name_path=propagate_int
+-return_type=INT64
+-argument_name_list=[f, x]
+-signature=(FUNCTION<INT64->INT64> f, INT64 x) -> INT64
+-language="SQL"
+-code="apply_int(FUNCTION f, x)"
+-function_expression=
  +-FunctionCall(Lazy_resolution_function:apply_int(FUNCTION<INT64->INT64> f, INT64 x) -> INT64)
    +-FunctionArgument
    | +-function_ref=
    |   +-FunctionRef(function=FUNCTION_TYPED_PARAMETER:f, signature=(INT64) -> INT64)
    +-FunctionArgument
      +-expr=
        +-ArgumentRef(type=INT64, name="x")
==

