# UDF Lambda Inlining: Correlated array join inside lambda body.
# Verifies that a correlated array join (FROM t, UNNEST(t.arr)) inside a lambda
# body correctly preserves correlation when inlined.
[enabled_ast_rewrites=DEFAULTS,+INLINE_SQL_FUNCTIONS]
[use_database=udf_db_with_apply_int]
WITH T1 AS (SELECT 1 as id, [10, 20] as arr UNION ALL SELECT 2, [30, 40])
SELECT id, apply_int(x -> (
  SELECT SUM(y + x)
  FROM T1 AS t, UNNEST(t.arr) AS y
  WHERE t.id = id
), 5) as res
FROM T1;
--
QueryStmt
+-output_column_list=
| +-T1.id#7 AS id [INT64]
| +-$query.res#14 AS res [INT64]
+-query=
  +-WithScan
    +-column_list=[T1.id#7, $query.res#14]
    +-with_entry_list=
    | +-WithEntry
    |   +-with_query_name="T1"
    |   +-with_subquery=
    |     +-SetOperationScan
    |       +-column_list=$union_all.[id#5, arr#6]
    |       +-op_type=UNION_ALL
    |       +-input_item_list=
    |         +-SetOperationItem
    |         | +-scan=
    |         | | +-ProjectScan
    |         | |   +-column_list=$union_all1.[id#1, arr#2]
    |         | |   +-expr_list=
    |         | |   | +-id#1 := Literal(type=INT64, value=1)
    |         | |   | +-arr#2 := Literal(type=ARRAY<INT64>, value=[10, 20])
    |         | |   +-input_scan=
    |         | |     +-SingleRowScan
    |         | +-output_column_list=$union_all1.[id#1, arr#2]
    |         +-SetOperationItem
    |           +-scan=
    |           | +-ProjectScan
    |           |   +-column_list=$union_all2.[$col1#3, $col2#4]
    |           |   +-expr_list=
    |           |   | +-$col1#3 := Literal(type=INT64, value=2)
    |           |   | +-$col2#4 := Literal(type=ARRAY<INT64>, value=[30, 40])
    |           |   +-input_scan=
    |           |     +-SingleRowScan
    |           +-output_column_list=$union_all2.[$col1#3, $col2#4]
    +-query=
      +-ProjectScan
        +-column_list=[T1.id#7, $query.res#14]
        +-expr_list=
        | +-res#14 :=
        |   +-FunctionCall(Lazy_resolution_function:apply_int(FUNCTION<INT64->INT64> f, INT64 x) -> INT64)
        |     +-FunctionArgument
        |     | +-inline_lambda=
        |     |   +-InlineLambda
        |     |     +-argument_list=[$lambda_arg.x#9]
        |     |     +-body=
        |     |       +-SubqueryExpr
        |     |         +-type=INT64
        |     |         +-subquery_type=SCALAR
        |     |         +-parameter_list=
        |     |         | +-ColumnRef(type=INT64, column=$lambda_arg.x#9)
        |     |         +-subquery=
        |     |           +-ProjectScan
        |     |             +-column_list=[$aggregate.$agg1#13]
        |     |             +-input_scan=
        |     |               +-AggregateScan
        |     |                 +-column_list=[$aggregate.$agg1#13]
        |     |                 +-input_scan=
        |     |                 | +-FilterScan
        |     |                 |   +-column_list=[T1.id#10, T1.arr#11, $array.y#12]
        |     |                 |   +-input_scan=
        |     |                 |   | +-ArrayScan
        |     |                 |   |   +-column_list=[T1.id#10, T1.arr#11, $array.y#12]
        |     |                 |   |   +-input_scan=
        |     |                 |   |   | +-WithRefScan(column_list=T1.[id#10, arr#11], with_query_name="T1")
        |     |                 |   |   +-array_expr_list=
        |     |                 |   |   | +-ColumnRef(type=ARRAY<INT64>, column=T1.arr#11)
        |     |                 |   |   +-element_column_list=[$array.y#12]
        |     |                 |   +-filter_expr=
        |     |                 |     +-FunctionCall(GoogleSQL:$equal(INT64, INT64) -> BOOL)
        |     |                 |       +-ColumnRef(type=INT64, column=T1.id#10)
        |     |                 |       +-ColumnRef(type=INT64, column=T1.id#10)
        |     |                 +-aggregate_list=
        |     |                   +-$agg1#13 :=
        |     |                     +-AggregateFunctionCall(GoogleSQL:sum(INT64) -> INT64)
        |     |                       +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
        |     |                         +-ColumnRef(type=INT64, column=$array.y#12)
        |     |                         +-ColumnRef(type=INT64, column=$lambda_arg.x#9, is_correlated=TRUE)
        |     +-FunctionArgument
        |       +-expr=
        |         +-Literal(type=INT64, value=5)
        +-input_scan=
          +-WithRefScan(column_list=T1.[id#7, arr#8], with_query_name="T1")

