CreateFunctionStmt
+-name_path=ForwardWithCollidingParamName
+-return_type=ARRAY<BOOL>
+-argument_name_list=[arr, f2]
+-signature=(ARRAY<INT64> arr, FUNCTION<INT64->INT64> f2) -> ARRAY<BOOL>
+-language="SQL"
+-code="MultiPropagate(arr, FUNCTION f2, x -> x > 0)"
+-function_expression=
  +-FunctionCall(Lazy_resolution_function:MultiPropagate(ARRAY<INT64> arr, FUNCTION<INT64->INT64> f1, FUNCTION<INT64->BOOL> f2) -> ARRAY<BOOL>)
    +-FunctionArgument
    | +-expr=
    |   +-ArgumentRef(type=ARRAY<INT64>, name="arr")
    +-FunctionArgument
    | +-function_ref=
    |   +-FunctionRef(function=FUNCTION_TYPED_PARAMETER:f2, signature=(INT64) -> INT64)
    +-FunctionArgument
      +-inline_lambda=
        +-InlineLambda
          +-argument_list=[$lambda_arg.x#1]
          +-body=
            +-FunctionCall(GoogleSQL:$greater(INT64, INT64) -> BOOL)
              +-ColumnRef(type=INT64, column=$lambda_arg.x#1)
              +-Literal(type=INT64, value=0)

