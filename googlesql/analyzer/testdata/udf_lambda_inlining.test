    |         | |   | +-val#2 := Literal(type=INT64, value=10)
    |         | |   +-input_scan=
    |         | |     +-SingleRowScan
    |         | +-output_column_list=$union_all1.[id#1, val#2]
    |         +-SetOperationItem
    |           +-scan=
    |           | +-ProjectScan
    |           |   +-column_list=$union_all2.[$col1#3, $col2#4]
    |           |   +-expr_list=
    |           |   | +-$col1#3 := Literal(type=INT64, value=2)
    |           |   | +-$col2#4 := Literal(type=INT64, value=20)
    |           |   +-input_scan=
    |           |     +-SingleRowScan
    |           +-output_column_list=$union_all2.[$col1#3, $col2#4]
    +-query=
      +-ProjectScan
        +-column_list=[T1.id#7, $query.case15#11]
        +-expr_list=
        | +-case15#11 :=
        |   +-SubqueryExpr
        |     +-type=INT64
        |     +-subquery_type=SCALAR
        |     +-parameter_list=
        |     | +-ColumnRef(type=INT64, column=T1.val#8)
        |     +-subquery=
        |       +-ProjectScan
        |         +-column_list=[$expr_subquery.$col1#10]
        |         +-expr_list=
        |         | +-$col1#10 :=
        |         |   +-FunctionCall(Lazy_resolution_function:apply_int(FUNCTION<INT64->INT64> f, INT64 x) -> INT64)
        |         |     +-FunctionArgument
        |         |     | +-inline_lambda=
