# Verifies that passing a lambda that forwards the caller's own function-typed
# parameter 'f' into 'ApplyIntInSubquery' does not cause double lambda expansion
# or infinite recursion during AST rewriting.
[enabled_ast_rewrites=DEFAULTS,+INLINE_SQL_FUNCTIONS]
