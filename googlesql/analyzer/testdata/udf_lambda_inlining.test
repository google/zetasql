# Verifies inlining an inner built-in higher-order function (APPLY) that
# receives a function-typed parameter reference inside a lambda passed to
# another built-in function (MAP_REPLACE).
[language_features=NONE,+INLINE_LAMBDA_ARGUMENT,+UDF_LAMBDA_ARGUMENTS,+WITH_EXPRESSION,+MAP_TYPE,+HAVING_IN_AGGREGATE,+CHAINED_FUNCTION_CALLS]
[enabled_ast_rewrites=DEFAULTS,+INLINE_SQL_FUNCTIONS]
