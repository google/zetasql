        |         |     |     +-argument_list=[$lambda_arg.x#9]
        |         |     |     +-parameter_list=
        |         |     |     | +-ColumnRef(type=INT64, column=T1.val#8, is_correlated=TRUE)
        |         |     |     +-body=
        |         |     |       +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
        |         |     |         +-ColumnRef(type=INT64, column=$lambda_arg.x#9)
        |         |     |         +-ColumnRef(type=INT64, column=T1.val#8, is_correlated=TRUE)
        |         |     +-FunctionArgument
        |         |       +-expr=
        |         |         +-Literal(type=INT64, value=5)
        |         +-input_scan=
        |           +-SingleRowScan
        +-input_scan=
          +-WithRefScan(column_list=T1.[id#7, val#8], with_query_name="T1")

