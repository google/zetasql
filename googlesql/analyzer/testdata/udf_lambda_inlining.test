#####
## UDF Lambda Inlining Test Cases
#####

# UDF Lambda Inlining: g2 call inlining.
# Verifies that calling a UDF with a single lambda parameter (such as 'g2')
# correctly inlines the lambda body in the output scan.
[enabled_ast_rewrites=DEFAULTS,+INLINE_SQL_FUNCTIONS]
[use_database=udf_db_with_g2]
SELECT g2(x -> x > 0);
--
QueryStmt
+-output_column_list=
| +-$query.$col1#2 AS `$col1` [BOOL]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#2]
    +-expr_list=
    | +-$col1#2 :=
    |   +-FunctionCall(Lazy_resolution_function:g2(FUNCTION<INT64->BOOL> p2) -> BOOL)
    |     +-FunctionArgument
    |       +-inline_lambda=
    |         +-InlineLambda
    |           +-argument_list=[$lambda_arg.x#1]
    |           +-body=
    |             +-FunctionCall(GoogleSQL:$greater(INT64, INT64) -> BOOL)
    |               +-ColumnRef(type=INT64, column=$lambda_arg.x#1)
    |               +-Literal(type=INT64, value=0)
    +-input_scan=
      +-SingleRowScan

[REWRITTEN AST]
QueryStmt
+-output_column_list=
| +-$query.$col1#2 AS `$col1` [BOOL]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#2]
    +-expr_list=
    | +-$col1#2 :=
    |   +-SubqueryExpr
    |     +-type=BOOL
    |     +-subquery_type=SCALAR
    |     +-subquery=
    |       +-ProjectScan
    |         +-column_list=[$with_expr.injected#4]
    |         +-expr_list=
    |         | +-injected#4 :=
    |         |   +-FunctionCall(GoogleSQL:$greater(INT64, INT64) -> BOOL)
    |         |     +-ColumnRef(type=INT64, column=$inlined_lambda.x#3)
    |         |     +-Literal(type=INT64, value=0)
    |         +-input_scan=
    |           +-ProjectScan
    |             +-column_list=[$inlined_lambda.x#3]
    |             +-expr_list=
    |             | +-x#3 := Literal(type=INT64, value=1)
    |             +-input_scan=
    |               +-SingleRowScan
    +-input_scan=
      +-SingleRowScan
==

# Test calling a lambda with SAFE mode enabled.
[enabled_ast_rewrites=DEFAULTS,+INLINE_SQL_FUNCTIONS,+WITH_EXPR]
[use_database=udf_db_safe_mode]
SELECT test_safe(x -> 1.0/x, 0);
--
QueryStmt
+-output_column_list=
| +-$query.$col1#2 AS `$col1` [DOUBLE]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#2]
    +-expr_list=
    | +-$col1#2 :=
    |   +-FunctionCall(Lazy_resolution_function:test_safe(FUNCTION<INT64->DOUBLE> p, INT64 x) -> DOUBLE)
    |     +-FunctionArgument
    |     | +-inline_lambda=
    |     |   +-InlineLambda
    |     |     +-argument_list=[$lambda_arg.x#1]
    |     |     +-body=
    |     |       +-FunctionCall(GoogleSQL:$divide(DOUBLE, DOUBLE) -> DOUBLE)
    |     |         +-Literal(type=DOUBLE, value=1)
    |     |         +-Cast(INT64 -> DOUBLE)
    |     |           +-ColumnRef(type=INT64, column=$lambda_arg.x#1)
    |     +-FunctionArgument
    |       +-expr=
    |         +-Literal(type=INT64, value=0)
    +-input_scan=
      +-SingleRowScan

[REWRITTEN AST]
QueryStmt
+-output_column_list=
| +-$query.$col1#2 AS `$col1` [DOUBLE]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#2]
    +-expr_list=
    | +-$col1#2 :=
    |   +-SubqueryExpr
    |     +-type=DOUBLE
    |     +-subquery_type=SCALAR
    |     +-subquery=
    |       +-ProjectScan
    |         +-column_list=[$with_expr.injected#5]
    |         +-expr_list=
    |         | +-injected#5 :=
    |         |   +-SubqueryExpr
    |         |     +-type=DOUBLE
    |         |     +-subquery_type=SCALAR
    |         |     +-parameter_list=
    |         |     | +-ColumnRef(type=INT64, column=$inlined_test_safe.x#3)
    |         |     +-subquery=
    |         |       +-ProjectScan
    |         |         +-column_list=[$with_expr.injected#6]
    |         |         +-expr_list=
    |         |         | +-injected#6 :=
    |         |         |   +-FunctionCall(GoogleSQL:iferror(DOUBLE, DOUBLE) -> DOUBLE)
    |         |         |     +-FunctionCall(GoogleSQL:$divide(DOUBLE, DOUBLE) -> DOUBLE)
    |         |         |     | +-Literal(type=DOUBLE, value=1)
