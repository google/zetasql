    | +-$col1#4 :=
    |   +-FunctionCall(Lazy_resolution_function:apply_int(FUNCTION<INT64->INT64> f, INT64 x) -> INT64)
    |     +-FunctionArgument
    |     | +-inline_lambda=
    |     |   +-InlineLambda
    |     |     +-argument_list=[$lambda_arg.x#2]
    |     |     +-parameter_list=
    |     |     | +-ColumnRef(type=INT64, column=$subquery1.a#1)
    |     |     +-body=
    |     |       +-FunctionCall(GoogleSQL:$array_at_offset(ARRAY<INT64>, INT64) -> INT64)
    |     |         +-FunctionCall(GoogleSQL:array_transform(ARRAY<INT64> array_to_transform, FUNCTION<INT64->INT64> transformation) -> ARRAY<INT64>)
    |     |         | +-FunctionArgument
    |     |         | | +-expr=
    |     |         | |   +-Literal(type=ARRAY<INT64>, value=[1, 2])
    |     |         | +-FunctionArgument
    |     |         |   +-inline_lambda=
    |     |         |     +-InlineLambda
    |     |         |       +-argument_list=[$lambda_arg.y#3]
    |     |         |       +-parameter_list=
    |     |         |       | +-ColumnRef(type=INT64, column=$subquery1.a#1, is_correlated=TRUE)
    |     |         |       | +-ColumnRef(type=INT64, column=$lambda_arg.x#2)
    |     |         |       +-body=
    |     |         |         +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
    |     |         |           +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
    |     |         |           | +-ColumnRef(type=INT64, column=$lambda_arg.x#2, is_correlated=TRUE)
    |     |         |           | +-ColumnRef(type=INT64, column=$lambda_arg.y#3)
    |     |         |           +-ColumnRef(type=INT64, column=$subquery1.a#1, is_correlated=TRUE)
    |     |         +-Literal(type=INT64, value=0)
    |     +-FunctionArgument
    |       +-expr=
    |         +-Literal(type=INT64, value=5)
    +-input_scan=
      +-ProjectScan
        +-column_list=[$subquery1.a#1]
        +-expr_list=
        | +-a#1 := Literal(type=INT64, value=1)
        +-input_scan=
          +-SingleRowScan

