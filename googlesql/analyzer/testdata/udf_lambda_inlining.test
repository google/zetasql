# UDF Lambda Inlining: Zero-arg lambda with a correlated array join inside the lambda body.
# Verifies that zero-argument lambdas (where captured_columns is non-null but empty) do not
# erroneously treat local subquery scan columns (y) as outer correlated references.
[enabled_ast_rewrites=DEFAULTS,+INLINE_SQL_FUNCTIONS]
[use_database=udf_db_inlining]
WITH T1 AS (SELECT 1 as id, [10, 20] as arr UNION ALL SELECT 2, [30, 40])
SELECT zero_arg(() -> (
  SELECT SUM(y)
  FROM T1 AS t, UNNEST(t.arr) AS y
))
FROM T1;
--
QueryStmt
+-output_column_list=
| +-$query.$col1#13 AS `$col1` [INT64]
+-query=
  +-WithScan
    +-column_list=[$query.$col1#13]
    +-with_entry_list=
    | +-WithEntry
    |   +-with_query_name="T1"
    |   +-with_subquery=
    |     +-SetOperationScan
    |       +-column_list=$union_all.[id#5, arr#6]
    |       +-op_type=UNION_ALL
    |       +-input_item_list=
    |         +-SetOperationItem
    |         | +-scan=
    |         | | +-ProjectScan
    |         | |   +-column_list=$union_all1.[id#1, arr#2]
    |         | |   +-expr_list=
    |         | |   | +-id#1 := Literal(type=INT64, value=1)
    |         | |   | +-arr#2 := Literal(type=ARRAY<INT64>, value=[10, 20])
    |         | |   +-input_scan=
    |         | |     +-SingleRowScan
    |         | +-output_column_list=$union_all1.[id#1, arr#2]
    |         +-SetOperationItem
    |           +-scan=
    |           | +-ProjectScan
    |           |   +-column_list=$union_all2.[$col1#3, $col2#4]
    |           |   +-expr_list=
    |           |   | +-$col1#3 := Literal(type=INT64, value=2)
    |           |   | +-$col2#4 := Literal(type=ARRAY<INT64>, value=[30, 40])
    |           |   +-input_scan=
    |           |     +-SingleRowScan
    |           +-output_column_list=$union_all2.[$col1#3, $col2#4]
    +-query=
      +-ProjectScan
        +-column_list=[$query.$col1#13]
        +-expr_list=
        | +-$col1#13 :=
        |   +-FunctionCall(Lazy_resolution_function:zero_arg(FUNCTION<()->INT64> p) -> INT64)
        |     +-FunctionArgument
        |       +-inline_lambda=
        |         +-InlineLambda
        |           +-argument_list=[]
        |           +-body=
        |             +-SubqueryExpr
        |               +-type=INT64
        |               +-subquery_type=SCALAR
        |               +-subquery=
        |                 +-ProjectScan
        |                   +-column_list=[$aggregate.$agg1#12]
        |                   +-input_scan=
        |                     +-AggregateScan
        |                       +-column_list=[$aggregate.$agg1#12]
        |                       +-input_scan=
        |                       | +-ArrayScan
        |                       |   +-column_list=[T1.id#9, T1.arr#10, $array.y#11]
        |                       |   +-input_scan=
        |                       |   | +-WithRefScan(column_list=T1.[id#9, arr#10], with_query_name="T1")
        |                       |   +-array_expr_list=
        |                       |   | +-ColumnRef(type=ARRAY<INT64>, column=T1.arr#10)
        |                       |   +-element_column_list=[$array.y#11]
        |                       +-aggregate_list=
        |                         +-$agg1#12 :=
        |                           +-AggregateFunctionCall(GoogleSQL:sum(INT64) -> INT64)
        |                             +-ColumnRef(type=INT64, column=$array.y#11)
        +-input_scan=
          +-WithRefScan(column_list=T1.[id#7, arr#8], with_query_name="T1")

