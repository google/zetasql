        |         |             +-column_list=[$inlined_lambda.x#8]
        |         |             +-expr_list=
        |         |             | +-x#8 := ColumnRef(type=INT64, column=$inlined_apply_int.x#7, is_correlated=TRUE)
        |         |             +-input_scan=
        |         |               +-SingleRowScan
        |         +-input_scan=
        |           +-ProjectScan
        |             +-column_list=[$inlined_apply_int.x#7]
        |             +-expr_list=
        |             | +-x#7 := Literal(type=INT64, value=5)
        |             +-input_scan=
        |               +-SingleRowScan
        +-input_scan=
          +-WithRefScan(column_list=T1.[id#3, val#4], with_query_name="T1")
==

# UDF Lambda Inlining: correlation in a correlated scalar subquery.
# This tests inlining inside a correlated subquery expression itself.
[enabled_ast_rewrites=DEFAULTS,+INLINE_SQL_FUNCTIONS,+WITH_EXPR]
[use_database=udf_db_with_apply_int]
WITH T1 AS (SELECT 1 as id, 10 as val UNION ALL SELECT 2, 20)
SELECT id, (SELECT apply_int(x -> x + val, 5)) as case15
FROM T1;
--

