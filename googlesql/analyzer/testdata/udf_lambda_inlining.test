# SELECT apply_int(
#   y -> (
#     SELECT gt.z FROM GRAPH_TABLE(aml
#       CALL (y) {
#         RETURN y + 1 AS z
#       }
#       RETURN z
#     ) gt
#   ),
#   10
# );
# --
# [Failed test result]
# ==

