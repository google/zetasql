+-name_path=apply_int_2
+-return_type=INT64
+-argument_name_list=[f, g, x]
+-signature=(FUNCTION<INT64->INT64> f, FUNCTION<INT64->INT64> g, INT64 x) -> INT64
+-language="SQL"
+-code="f(g(x))"
+-function_expression=
