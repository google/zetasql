# Inlines an inner SQL function call even when an outer function-typed parameter
# cannot be inlined yet because no concrete lambda is bound at function definition time.
[enabled_ast_rewrites=DEFAULTS,+INLINE_SQL_FUNCTIONS]
[use_database=udf_db_with_apply_int]
