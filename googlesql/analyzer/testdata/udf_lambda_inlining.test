    | +-$col1#2 :=
    |   +-FunctionCall(Lazy_resolution_function:OuterPropagate(ARRAY<INT64> arr, FUNCTION<INT64->BOOL> g) -> ARRAY<BOOL>)
    |     +-FunctionArgument
    |     | +-expr=
    |     |   +-Literal(type=ARRAY<INT64>, value=[1, 2, 3])
    |     +-FunctionArgument
    |       +-inline_lambda=
    |         +-InlineLambda
    |           +-argument_list=[$lambda_arg.y#1]
    |           +-body=
    |             +-FunctionCall(GoogleSQL:$greater(INT64, INT64) -> BOOL)
    |               +-ColumnRef(type=INT64, column=$lambda_arg.y#1)
    |               +-Literal(type=INT64, value=1)
    +-input_scan=
      +-SingleRowScan

