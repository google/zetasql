+-function_expression=
  +-FunctionCall(GoogleSQL:map_replace(MAP<STRING, INT64> input_map, STRING key, repeated(2) STRING repeated_key, FUNCTION<INT64->INT64> updater_lambda) -> MAP<STRING, INT64>)
