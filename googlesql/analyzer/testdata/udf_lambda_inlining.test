# Nested lambdas passed to an inlined UDF.
# This test verifies that column references inside nested lambdas remain correlated
# even when the outer lambda boundary is dissolved.
[enabled_ast_rewrites=DEFAULTS,+INLINE_SQL_FUNCTIONS]
[use_database=udf_db_with_apply_int]
SELECT apply_int(x -> (ARRAY_TRANSFORM([1, 2], y -> x + y + a))[OFFSET(0)], 5)
FROM (SELECT 1 as a);
--


QueryStmt
+-output_column_list=
| +-$query.$col1#4 AS `$col1` [INT64]
