+-argument_name_list=[array_to_transform]
+-signature=(ARRAY<INT64> array_to_transform) -> ARRAY<INT64>
+-language="SQL"
+-code="array_transform(array_to_transform, e -> e + 1)"
+-function_expression=
  +-FunctionCall(GoogleSQL:array_transform(ARRAY<INT64> array_to_transform, FUNCTION<INT64->INT64> transformation) -> ARRAY<INT64>)
    +-FunctionArgument
    | +-expr=
    |   +-ArgumentRef(type=ARRAY<INT64>, name="array_to_transform")
    +-FunctionArgument
      +-inline_lambda=
        +-InlineLambda
          +-argument_list=[$lambda_arg.e#1]
          +-body=
            +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
              +-ColumnRef(type=INT64, column=$lambda_arg.e#1)
              +-Literal(type=INT64, value=1)
==

[use_database=udf_db_with_transform]
[prepare_database=udf_db_with_transform]
# Defines a UDF that passes a lambda calling its function-typed parameter
# to PropagateTransform, which in turn passes it to built-in array_transform.
create function OuterPropagate(arr array<int64>, g function<int64 -> bool>)
as (PropagateTransform(arr, x -> g(x)));
--
CreateFunctionStmt
+-name_path=OuterPropagate
+-return_type=ARRAY<BOOL>
+-argument_name_list=[arr, g]
+-signature=(ARRAY<INT64> arr, FUNCTION<INT64->BOOL> g) -> ARRAY<BOOL>
+-language="SQL"
+-code="PropagateTransform(arr, x -> g(x))"
+-function_expression=
  +-FunctionCall(Lazy_resolution_function:PropagateTransform(ARRAY<INT64> arr, FUNCTION<INT64->BOOL> f) -> ARRAY<BOOL>)
    +-FunctionArgument
    | +-expr=
    |   +-ArgumentRef(type=ARRAY<INT64>, name="arr")
    +-FunctionArgument
      +-inline_lambda=
        +-InlineLambda
          +-argument_list=[$lambda_arg.x#1]
          +-body=
            +-FunctionCall(FUNCTION_TYPED_PARAMETER:g(INT64) -> BOOL)
              +-ColumnRef(type=INT64, column=$lambda_arg.x#1)
==

[prepare_database=udf_db_with_apply_int]
CREATE FUNCTION apply_int(f FUNCTION<INT64 -> INT64>, x INT64) AS (f(x));
--
CreateFunctionStmt
+-name_path=apply_int
+-return_type=INT64
+-argument_name_list=[f, x]
+-signature=(FUNCTION<INT64->INT64> f, INT64 x) -> INT64
+-language="SQL"
+-code="f(x)"
+-function_expression=
  +-FunctionCall(FUNCTION_TYPED_PARAMETER:f(INT64) -> INT64)
    +-ArgumentRef(type=INT64, name="x")
==

# Defines a UDF that passes a lambda containing a scalar subquery to apply_int.
[use_database=udf_db_with_apply_int]
[prepare_database=udf_db_with_apply_int]
CREATE FUNCTION outer_udf_with_subquery(a INT64) AS (apply_int(x -> (SELECT x + a), 10));
--
CreateFunctionStmt
+-name_path=outer_udf_with_subquery
+-return_type=INT64
+-argument_name_list=[a]
+-signature=(INT64 a) -> INT64
+-language="SQL"
+-code="apply_int(x -> (SELECT x + a), 10)"
+-function_expression=
  +-FunctionCall(Lazy_resolution_function:apply_int(FUNCTION<INT64->INT64> f, INT64 x) -> INT64)
    +-FunctionArgument
    | +-inline_lambda=
    |   +-InlineLambda
    |     +-argument_list=[$lambda_arg.x#1]
    |     +-body=
    |       +-SubqueryExpr
    |         +-type=INT64
    |         +-subquery_type=SCALAR
    |         +-parameter_list=
    |         | +-ColumnRef(type=INT64, column=$lambda_arg.x#1)
    |         +-subquery=
    |           +-ProjectScan
    |             +-column_list=[$expr_subquery.$col1#2]
    |             +-expr_list=
    |             | +-$col1#2 :=
    |             |   +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
    |             |     +-ColumnRef(type=INT64, column=$lambda_arg.x#1, is_correlated=TRUE)
    |             |     +-ArgumentRef(type=INT64, name="a")
    |             +-input_scan=
    |               +-SingleRowScan
    +-FunctionArgument
      +-expr=
        +-Literal(type=INT64, value=10)
==

# Defines a UDF with nested ARRAY_TRANSFORM lambdas referencing a UDF argument.
[use_database=udf_db_with_apply_int]
[prepare_database=udf_db_with_apply_int]
CREATE FUNCTION nested_lambdas_udf(arr ARRAY<INT64>, a INT64) AS (
  ARRAY_TRANSFORM(arr, x -> (ARRAY_TRANSFORM([1, 2], y -> x + y + a))[OFFSET(0)])
);
--
CreateFunctionStmt
+-name_path=nested_lambdas_udf
+-return_type=ARRAY<INT64>
+-argument_name_list=[arr, a]
+-signature=(ARRAY<INT64> arr, INT64 a) -> ARRAY<INT64>
+-language="SQL"
+-code="ARRAY_TRANSFORM(arr, x -> (ARRAY_TRANSFORM([1, 2], y -> x + y + a))[OFFSET(0)])"
+-function_expression=
  +-FunctionCall(GoogleSQL:array_transform(ARRAY<INT64> array_to_transform, FUNCTION<INT64->INT64> transformation) -> ARRAY<INT64>)
    +-FunctionArgument
    | +-expr=
    |   +-ArgumentRef(type=ARRAY<INT64>, name="arr")
    +-FunctionArgument
      +-inline_lambda=
        +-InlineLambda
          +-argument_list=[$lambda_arg.x#1]
          +-body=
            +-FunctionCall(GoogleSQL:$array_at_offset(ARRAY<INT64>, INT64) -> INT64)
              +-FunctionCall(GoogleSQL:array_transform(ARRAY<INT64> array_to_transform, FUNCTION<INT64->INT64> transformation) -> ARRAY<INT64>)
              | +-FunctionArgument
              | | +-expr=
              | |   +-Literal(type=ARRAY<INT64>, value=[1, 2])
              | +-FunctionArgument
              |   +-inline_lambda=
              |     +-InlineLambda
              |       +-argument_list=[$lambda_arg.y#2]
              |       +-parameter_list=
              |       | +-ColumnRef(type=INT64, column=$lambda_arg.x#1)
              |       +-body=
              |         +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
              |           +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
              |           | +-ColumnRef(type=INT64, column=$lambda_arg.x#1, is_correlated=TRUE)
              |           | +-ColumnRef(type=INT64, column=$lambda_arg.y#2)
              |           +-ArgumentRef(type=INT64, name="a")
              +-Literal(type=INT64, value=0)
==

[prepare_database=udf_db_with_apply_int]
