+-name_path=call_param_and_inlined_udf
+-return_type=INT64
+-argument_name_list=[f, x]
+-signature=(FUNCTION<INT64->INT64> f, INT64 x) -> INT64
+-language="SQL"
+-code="f(x) + apply_int(y -> y + 1, x)"
+-function_expression=
  +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
    +-FunctionCall(FUNCTION_TYPED_PARAMETER:f(INT64) -> INT64)
    | +-ArgumentRef(type=INT64, name="x")
    +-FunctionCall(Lazy_resolution_function:apply_int(FUNCTION<INT64->INT64> f, INT64 x) -> INT64)
      +-FunctionArgument
      | +-inline_lambda=
      |   +-InlineLambda
      |     +-argument_list=[$lambda_arg.y#1]
      |     +-body=
      |       +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
      |         +-ColumnRef(type=INT64, column=$lambda_arg.y#1)
      |         +-Literal(type=INT64, value=1)
      +-FunctionArgument
        +-expr=
          +-ArgumentRef(type=INT64, name="x")

