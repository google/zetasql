# UDF Lambda Inlining: Direct call to templated UDF with a lambda argument.
# Verifies that calling a templated UDF directly with a lambda argument
# correctly resolves, inlines, and maps the template parameter and the lambda.
[enabled_ast_rewrites=DEFAULTS,+INLINE_SQL_FUNCTIONS]
[use_database=udf_db_templated_inlining]
[language_features=NONE,+INLINE_LAMBDA_ARGUMENT,+UDF_LAMBDA_ARGUMENTS,+TEMPLATE_FUNCTIONS]
SELECT templated_udf(1, x -> x > 0);
--
QueryStmt
+-output_column_list=
| +-$query.$col1#2 AS `$col1` [BOOL]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#2]
    +-expr_list=
    | +-$col1#2 :=
    |   +-FunctionCall(Templated_SQL_Function:templated_udf(INT64 x, FUNCTION<INT64->BOOL> p) -> BOOL)
    |     +-FunctionArgument
    |     | +-expr=
    |     |   +-Literal(type=INT64, value=1)
    |     +-FunctionArgument
    |       +-inline_lambda=
    |         +-InlineLambda
    |           +-argument_list=[$lambda_arg.x#1]
    |           +-body=
    |             +-FunctionCall(GoogleSQL:$greater(INT64, INT64) -> BOOL)
    |               +-ColumnRef(type=INT64, column=$lambda_arg.x#1)
    |               +-Literal(type=INT64, value=0)
    +-input_scan=
      +-SingleRowScan

