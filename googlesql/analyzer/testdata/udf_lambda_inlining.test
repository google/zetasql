# Verifies that forwarding a caller's function-typed parameter 'f2' into a
# callee's first parameter 'f1' (where 'MultiPropagate' has parameters 'f1' and
# 'f2' and forwards 'FUNCTION f1' and 'FUNCTION f2' as arguments) does not
# trigger a second lookup on 'f2' and overwrite the forwarded reference with the
# concrete lambda passed for 'f2'.
[enabled_ast_rewrites=DEFAULTS,+INLINE_SQL_FUNCTIONS]
[use_database=udf_db_with_transform]
CREATE FUNCTION ForwardWithCollidingParamName(
    arr ARRAY<INT64>, f2 FUNCTION<INT64 -> INT64>) AS (
  MultiPropagate(arr, FUNCTION f2, x -> x > 0)
);
