#####
## Database preparation
#####

[default language_features=NONE,+INLINE_LAMBDA_ARGUMENT,+UDF_LAMBDA_ARGUMENTS,+WITH_EXPRESSION]

[prepare_database=udf_db_with_g2]
create function g2(p2 FUNCTION<INT64 -> BOOL>) AS (p2(1));
--
CreateFunctionStmt
+-name_path=g2
+-return_type=BOOL
+-argument_name_list=[p2]
+-signature=(FUNCTION<INT64->BOOL> p2) -> BOOL
+-language="SQL"
+-code="p2(1)"
+-function_expression=
  +-FunctionCall(FUNCTION_TYPED_PARAMETER:p2(INT64) -> BOOL)
    +-Literal(type=INT64, value=1)
==

[prepare_database=udf_db_with_transform]
create function PropagateTransform(arr array<int64>, f function<int64 -> bool>)
as (array_transform(arr, FUNCTION f));
--
CreateFunctionStmt
+-name_path=PropagateTransform
+-return_type=ARRAY<BOOL>
+-argument_name_list=[arr, f]
+-signature=(ARRAY<INT64> arr, FUNCTION<INT64->BOOL> f) -> ARRAY<BOOL>
+-language="SQL"
+-code="array_transform(arr, FUNCTION f)"
+-function_expression=
  +-FunctionCall(GoogleSQL:array_transform(ARRAY<INT64> array_to_transform, FUNCTION<INT64->BOOL> transformation) -> ARRAY<BOOL>)
    +-FunctionArgument
    | +-expr=
    |   +-ArgumentRef(type=ARRAY<INT64>, name="arr")
    +-FunctionArgument
      +-function_ref=
        +-FunctionRef(function=FUNCTION_TYPED_PARAMETER:f, signature=(INT64) -> BOOL)
==

[prepare_database=udf_db_with_transform]
# Multiple function-typed parameters passed where lambdas are expected.
create function MultiPropagate(arr array<int64>, f1 function<int64 -> int64>, f2 function<int64 -> bool>)
as (array_transform(array_transform(arr, FUNCTION f1), FUNCTION f2));
--
CreateFunctionStmt
+-name_path=MultiPropagate
+-return_type=ARRAY<BOOL>
+-argument_name_list=[arr, f1, f2]
+-signature=(ARRAY<INT64> arr, FUNCTION<INT64->INT64> f1, FUNCTION<INT64->BOOL> f2) -> ARRAY<BOOL>
+-language="SQL"
+-code="array_transform(array_transform(arr, FUNCTION f1), FUNCTION f2)"
+-function_expression=
  +-FunctionCall(GoogleSQL:array_transform(ARRAY<INT64> array_to_transform, FUNCTION<INT64->BOOL> transformation) -> ARRAY<BOOL>)
    +-FunctionArgument
    | +-expr=
    |   +-FunctionCall(GoogleSQL:array_transform(ARRAY<INT64> array_to_transform, FUNCTION<INT64->INT64> transformation) -> ARRAY<INT64>)
    |     +-FunctionArgument
    |     | +-expr=
    |     |   +-ArgumentRef(type=ARRAY<INT64>, name="arr")
    |     +-FunctionArgument
    |       +-function_ref=
    |         +-FunctionRef(function=FUNCTION_TYPED_PARAMETER:f1, signature=(INT64) -> INT64)
    +-FunctionArgument
      +-function_ref=
        +-FunctionRef(function=FUNCTION_TYPED_PARAMETER:f2, signature=(INT64) -> BOOL)
==

[prepare_database=udf_db_with_transform]
create function AggregateArrayLambda(value array<int64>)
as (array_transform(value, e -> e + 1));
--
CreateFunctionStmt
+-name_path=AggregateArrayLambda
+-return_type=ARRAY<INT64>
+-argument_name_list=[value]
+-signature=(ARRAY<INT64> value) -> ARRAY<INT64>
+-language="SQL"
+-code="array_transform(value, e -> e + 1)"
+-function_expression=
  +-FunctionCall(GoogleSQL:array_transform(ARRAY<INT64> array_to_transform, FUNCTION<INT64->INT64> transformation) -> ARRAY<INT64>)
    +-FunctionArgument
    | +-expr=
    |   +-ArgumentRef(type=ARRAY<INT64>, name="value")
    +-FunctionArgument
      +-inline_lambda=
        +-InlineLambda
          +-argument_list=[$lambda_arg.e#1]
          +-body=
            +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
              +-ColumnRef(type=INT64, column=$lambda_arg.e#1)
              +-Literal(type=INT64, value=1)
==

[prepare_database=udf_db_with_transform]
create function TestArrayTransform(array_to_transform array<int64>)
as (array_transform(array_to_transform, e -> e + 1));
