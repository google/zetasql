SELECT * FROM LookupTable(STRUCT("KeyValue" AS col).col)
--
QueryStmt
+-output_column_list=
| +-LookupTable.Key#1 AS Key [INT64]
| +-LookupTable.Value#2 AS Value [STRING]
+-query=
  +-ProjectScan
    +-column_list=LookupTable.[Key#1, Value#2]
    +-input_scan=
      +-TVFScan
        +-column_list=LookupTable.[Key#1, Value#2]
        +-tvf=GoogleSQL:LookupTable
        +-signature=(STRING) -> TABLE<Key INT64, Value STRING> (table: KeyValue)
        +-argument_list=
        | +-FunctionArgument
        |   +-expr=
        |     +-GetStructField
        |       +-type=STRING
        |       +-expr=
        |       | +-Literal(type=STRUCT<col STRING>, value={col:"KeyValue"})
        |       +-field_idx=0
        +-column_index_list=[0, 1]
        +-function_call_signature=(STRING) -> ANY TABLE

[REWRITTEN AST]
QueryStmt
