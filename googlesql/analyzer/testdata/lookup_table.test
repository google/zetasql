# We haven't added the support for describing TVFs with table schema to Java.
# TODO: b/462152462 - Add the Java support for serializing and deserializing
# the `result_table_schema_` field.
[default no_java]
[default no_enable_literal_replacement]
[default language_features=MAXIMUM,+LOOKUP_TABLE_TVF]
[default enabled_ast_rewrites=DEFAULTS,+LOOKUP_TABLE_TVF]

[language_features=MAXIMUM,-LOOKUP_TABLE_TVF]
# Feature disabled by default in MAXIMUM.
SELECT * FROM LookupTable("KeyValue")
--
ERROR: Table-valued function not found: LookupTable [at 2:15]
SELECT * FROM LookupTable("KeyValue")
              ^
==

SELECT * FROM LookupTable()
--
ERROR: No matching signature for LookupTable with no arguments
  Signature: LOOKUPTABLE(STRING)
    Signature requires at least 1 argument, found 0 arguments [at 1:15]
SELECT * FROM LookupTable()
              ^
==

SELECT * FROM LookupTable(123)
--
ERROR: No matching signature for LookupTable
  Argument types: INT64
  Signature: LOOKUPTABLE(STRING)
    Argument 1: Unable to coerce type INT64 to expected type STRING [at 1:15]
SELECT * FROM LookupTable(123)
              ^
==

SELECT * FROM LookupTable("test", "test")
--
ERROR: No matching signature for LookupTable
  Argument types: STRING, STRING
  Signature: LOOKUPTABLE(STRING)
    Signature accepts at most 1 argument, found 2 arguments [at 1:15]
SELECT * FROM LookupTable("test", "test")
              ^
==

SELECT * FROM LookupTable(NULL)
--
ERROR: The argument to table-valued function LOOKUPTABLE must be non-NULL [at 1:27]
SELECT * FROM LookupTable(NULL)
                          ^
==

SELECT * FROM LookupTable(CAST(NULL AS STRING))
--
ERROR: The argument to table-valued function LOOKUPTABLE must be non-NULL [at 1:27]
SELECT * FROM LookupTable(CAST(NULL AS STRING))
                          ^
==

SELECT * FROM LookupTable("test")
--
ERROR: Invalid table-valued function LookupTable [at 1:15]
SELECT * FROM LookupTable("test")
              ^
Table not found: test not found in catalog sample_catalog
==

# Invalid path expressions
SELECT * FROM LookupTable("")
--
ERROR: Invalid table-valued function LookupTable [at 1:15]
SELECT * FROM LookupTable("")
              ^
Path strings cannot be empty
==

SELECT * FROM LookupTable("MyTa)ble")
--
ERROR: Invalid table-valued function LookupTable [at 1:15]
SELECT * FROM LookupTable("MyTa)ble")
              ^
Path contains an invalid character ')'
==

SELECT * FROM LookupTable("KeyValue ")
--
ERROR: Invalid table-valued function LookupTable [at 1:15]
SELECT * FROM LookupTable("KeyValue ")
              ^
Path contains an invalid character ' '
==

SELECT * FROM LookupTable(" KeyValue")
--
ERROR: Invalid table-valued function LookupTable [at 1:15]
SELECT * FROM LookupTable(" KeyValue")
              ^
Path contains an invalid character ' '
==

SELECT * FROM LookupTable("My-Table.`20250102`")
--
ERROR: Invalid table-valued function LookupTable [at 1:15]
SELECT * FROM LookupTable("My-Table.`20250102`")
              ^
Path contains an invalid character '-'
==

# Valid table lookups
SELECT * FROM LookupTable("KeyValue")
--
QueryStmt
+-output_column_list=
| +-LookupTable.Key#1 AS Key [INT64]
| +-LookupTable.Value#2 AS Value [STRING]
+-query=
  +-ProjectScan
    +-column_list=LookupTable.[Key#1, Value#2]
    +-input_scan=
      +-TVFScan
        +-column_list=LookupTable.[Key#1, Value#2]
        +-tvf=GoogleSQL:LookupTable
        +-signature=(literal STRING) -> TABLE<Key INT64, Value STRING> (table: KeyValue)
        +-argument_list=
        | +-FunctionArgument
        |   +-expr=
        |     +-Literal(type=STRING, value="KeyValue", preserve_in_literal_remover=TRUE)
        +-column_index_list=[0, 1]
        +-function_call_signature=(STRING) -> ANY TABLE

[REWRITTEN AST]
QueryStmt
+-output_column_list=
| +-KeyValue.Key#1 AS Key [INT64]
| +-KeyValue.Value#2 AS Value [STRING]
+-query=
  +-ProjectScan
    +-column_list=KeyValue.[Key#1, Value#2]
    +-input_scan=
      +-TableScan(column_list=KeyValue.[Key#1, Value#2], table=KeyValue, column_index_list=[0, 1])
==

