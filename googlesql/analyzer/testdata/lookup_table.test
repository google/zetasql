# Multiple LookupTable calls (e.g. JOIN)
SELECT t1.Key, t2.Value
FROM LookupTable("KeyValue") AS t1
JOIN LookupTable("nested_catalog.KeyValue") AS t2
ON t1.Key = t2.Key
--
QueryStmt
+-output_column_list=
| +-LookupTable.Key#1 AS Key [INT64]
| +-LookupTable.Value#4 AS Value [STRING]
+-query=
  +-ProjectScan
    +-column_list=LookupTable.[Key#1, Value#4]
    +-input_scan=
      +-JoinScan
        +-column_list=LookupTable.[Key#1, Key#3, Value#4]
        +-left_scan=
        | +-TVFScan
        |   +-column_list=[LookupTable.Key#1]
        |   +-tvf=GoogleSQL:LookupTable
        |   +-signature=(literal STRING) -> TABLE<Key INT64, Value STRING> (table: KeyValue)
        |   +-argument_list=
        |   | +-FunctionArgument
        |   |   +-expr=
        |   |     +-Literal(type=STRING, value="KeyValue", preserve_in_literal_remover=TRUE)
        |   +-column_index_list=[0]
        |   +-alias="t1"
        |   +-function_call_signature=(STRING) -> ANY TABLE
        +-right_scan=
        | +-TVFScan
        |   +-column_list=LookupTable.[Key#3, Value#4]
        |   +-tvf=GoogleSQL:LookupTable
        |   +-signature=(literal STRING) -> TABLE<Key INT64, Value STRING> (table: KeyValue)
        |   +-argument_list=
        |   | +-FunctionArgument
        |   |   +-expr=
        |   |     +-Literal(type=STRING, value="nested_catalog.KeyValue", preserve_in_literal_remover=TRUE)
        |   +-column_index_list=[0, 1]
        |   +-alias="t2"
        |   +-function_call_signature=(STRING) -> ANY TABLE
        +-join_expr=
          +-FunctionCall(GoogleSQL:$equal(INT64, INT64) -> BOOL)
            +-ColumnRef(type=INT64, column=LookupTable.Key#1)
            +-ColumnRef(type=INT64, column=LookupTable.Key#3)

[REWRITTEN AST]
QueryStmt
+-output_column_list=
| +-KeyValue.Key#1 AS Key [INT64]
| +-KeyValue.Value#4 AS Value [STRING]
+-query=
  +-ProjectScan
    +-column_list=KeyValue.[Key#1, Value#4]
    +-input_scan=
      +-JoinScan
        +-column_list=KeyValue.[Key#1, Key#3, Value#4]
        +-left_scan=
        | +-TableScan(column_list=[KeyValue.Key#1], table=KeyValue, column_index_list=[0], alias="t1")
        +-right_scan=
        | +-TableScan(column_list=KeyValue.[Key#3, Value#4], table=KeyValue, column_index_list=[0, 1], alias="t2")
        +-join_expr=
          +-FunctionCall(GoogleSQL:$equal(INT64, INT64) -> BOOL)
            +-ColumnRef(type=INT64, column=KeyValue.Key#1)
            +-ColumnRef(type=INT64, column=KeyValue.Key#3)
==

