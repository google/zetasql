# Signature matching succeeds when `prompt` and `options` have the same number
# of STRUCT fields and coercible field types (INT64 and DOUBLE), but `prompt`
# has its INT64 field unnecessarily coerced to DOUBLE to match the common
# STRUCT supertype.
SELECT AI.IF(
  STRUCT("prompt", 1),
  options => STRUCT("opt1", 0.5));
--
QueryStmt
+-output_column_list=
| +-$query.$col1#1 AS `$col1` [BOOL]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#1]
    +-expr_list=
    | +-$col1#1 :=
    |   +-FunctionCall(GoogleSQL:ai.if(STRUCT<STRING, DOUBLE> prompt, STRUCT<STRING, DOUBLE> options) -> BOOL)
    |     +-Literal(type=STRUCT<STRING, DOUBLE>, value={"prompt", 1})
    |     +-Literal(type=STRUCT<STRING, DOUBLE>, value={"opt1", 0.5})
    +-input_scan=
      +-SingleRowScan
==

# Signature matching succeeds because a STRING literal is coercible to DATE,
# inferring the common supertype as STRUCT<DATE>, which then fails when
# attempting to cast the `prompt` string literal to DATE.
SELECT AI.IF(
  STRUCT("Is this valid?"),
  options => STRUCT(DATE '2025-01-01'));
--
ERROR: Could not cast literal {"Is this valid?"} to type STRUCT<DATE> [at 2:3]
  STRUCT("Is this valid?"),
  ^
==

# When `prompt` has an untyped NULL field, its type is incorrectly inferred
# from the corresponding field in `options` (JSON) instead of defaulting to
# INT64.
SELECT AI.IF(
  STRUCT("prompt", NULL),
  options => STRUCT("opt1", JSON '{"a": 1}'));
--
QueryStmt
+-output_column_list=
| +-$query.$col1#1 AS `$col1` [BOOL]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#1]
    +-expr_list=
    | +-$col1#1 :=
    |   +-FunctionCall(GoogleSQL:ai.if(STRUCT<STRING, JSON> prompt, STRUCT<STRING, JSON> options) -> BOOL)
    |     +-MakeStruct
    |     | +-type=STRUCT<STRING, JSON>
    |     | +-field_list=
    |     |   +-Literal(type=STRING, value="prompt")
    |     |   +-Literal(type=JSON, value=NULL)
    |     +-MakeStruct
    |       +-type=STRUCT<STRING, JSON>
    |       +-field_list=
    |         +-Literal(type=STRING, value="opt1")
    |         +-Literal(type=JSON, value={"a":1}, has_explicit_type=TRUE)
    +-input_scan=
      +-SingleRowScan
==

# When `prompt` and `options` contain nested STRUCTs at the same field position,
# the nested STRUCT field names in `options` are overwritten by the nested
# STRUCT field names in `prompt`.
SELECT AI.IF(
  STRUCT("prompt", STRUCT(1 AS nested_prompt_field)),
  options => STRUCT("opt1", STRUCT(2 AS nested_option_field)));
--
QueryStmt
+-output_column_list=
| +-$query.$col1#1 AS `$col1` [BOOL]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#1]
    +-expr_list=
    | +-$col1#1 :=
    |   +-FunctionCall(GoogleSQL:ai.if(STRUCT<STRING, STRUCT<nested_prompt_field INT64>> prompt, STRUCT<STRING, STRUCT<nested_prompt_field INT64>> options) -> BOOL)
    |     +-Literal(type=STRUCT<STRING, STRUCT<nested_prompt_field INT64>>, value={"prompt", {nested_prompt_field:1}})
    |     +-Literal(type=STRUCT<STRING, STRUCT<nested_prompt_field INT64>>, value={"opt1", {nested_prompt_field:2}})
    +-input_scan=
      +-SingleRowScan
==

# When `options` is a non-literal query-constant STRUCT (`MakeStruct`), its
# `MakeStruct` type is overwritten in-place with `prompt`'s STRUCT type, erasing
# its original field names.
SELECT AI.IF(
  STRUCT("prompt" AS prompt_field, "payload" AS payload_field),
  options => STRUCT(CONCAT("opt", "1") AS option_1, "opt2" AS option_2));
--
QueryStmt
+-output_column_list=
| +-$query.$col1#1 AS `$col1` [BOOL]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#1]
    +-expr_list=
    | +-$col1#1 :=
    |   +-FunctionCall(GoogleSQL:ai.if(STRUCT<prompt_field STRING, payload_field STRING> prompt, STRUCT<prompt_field STRING, payload_field STRING> options) -> BOOL)
    |     +-Literal(type=STRUCT<prompt_field STRING, payload_field STRING>, value={prompt_field:"prompt", payload_field:"payload"})
    |     +-MakeStruct
    |       +-type=STRUCT<prompt_field STRING, payload_field STRING>
    |       +-field_list=
    |         +-FunctionCall(GoogleSQL:concat(STRING, repeated(1) STRING) -> STRING)
    |         | +-Literal(type=STRING, value="opt")
    |         | +-Literal(type=STRING, value="1")
    |         +-Literal(type=STRING, value="opt2")
    +-input_scan=
      +-SingleRowScan
