# Dynamic graph: Explicitly specifying properties mapped to dynamic label and dynamic properties backing columns is allowed when no dynamic labels or dynamic properties are specified
GRAPH aml_dynamic
INSERT (p:Entity {id: 1, nodeLabelCol: "CustomLabel", nodeJsonProp: JSON '{"a": 1}'})-[e:Connection {edgeLabelCol: "CustomEdge", edgeJsonProp: JSON '{"b": 2}'}]->(q:Entity {id: 2})
--
GeneralizedQueryStmt
+-query=
  +-GraphTableScan
    +-property_graph=aml_dynamic
    +-input_scan=
      +-GraphLinearScan
        +-scan_list=
          +-GraphLinearScan
            +-scan_list=
              +-GraphInsertScan
              | +-column_list=$element_table.[p#1, q#2]
              | +-input_scan=
              | | +-SingleRowScan
              | +-insert_node_list=
              | | +-p#1 :=
              | | | +-GraphInsertElement
              | | |   +-type=GRAPH_NODE(aml_dynamic)<code INT64, id INT64, nodeJsonProp JSON, nodeLabelCol STRING, DYNAMIC>
              | | |   +-property_list=
              | | |   | +-GraphDMLPropertyItem
              | | |   | | +-property_name="id"
              | | |   | | +-property=id(INT64)
              | | |   | | +-property_value=
              | | |   | |   +-Literal(type=INT64, value=1)
              | | |   | +-GraphDMLPropertyItem
              | | |   | | +-property_name="nodeLabelCol"
              | | |   | | +-property=nodeLabelCol(STRING)
              | | |   | | +-property_value=
              | | |   | |   +-Literal(type=STRING, value="CustomLabel")
              | | |   | +-GraphDMLPropertyItem
              | | |   |   +-property_name="nodeJsonProp"
              | | |   |   +-property=nodeJsonProp(JSON)
              | | |   |   +-property_value=
              | | |   |     +-Literal(type=JSON, value={"a":1}, has_explicit_type=TRUE)
              | | |   +-label_list=
              | | |   | +-GraphLabel
              | | |   |   +-label=aml_dynamic.Entity
              | | |   |   +-label_name=
              | | |   |     +-Literal(type=STRING, value="Entity", has_explicit_type=TRUE)
              | | |   +-element_table=DynamicGraphNode
              | | +-q#2 :=
              | |   +-GraphInsertElement
              | |     +-type=GRAPH_NODE(aml_dynamic)<code INT64, id INT64, nodeJsonProp JSON, nodeLabelCol STRING, DYNAMIC>
              | |     +-property_list=
              | |     | +-GraphDMLPropertyItem
              | |     |   +-property_name="id"
              | |     |   +-property=id(INT64)
              | |     |   +-property_value=
              | |     |     +-Literal(type=INT64, value=2)
              | |     +-label_list=
              | |     | +-GraphLabel
              | |     |   +-label=aml_dynamic.Entity
              | |     |   +-label_name=
              | |     |     +-Literal(type=STRING, value="Entity", has_explicit_type=TRUE)
              | |     +-element_table=DynamicGraphNode
              | +-insert_edge_list=
              | | +-e#3 :=
              | |   +-GraphInsertElement
              | |     +-type=GRAPH_EDGE(aml_dynamic)<category STRING, dst_id INT64, edgeJsonProp JSON, edgeLabelCol STRING, id INT64, DYNAMIC>
              | |     +-property_list=
              | |     | +-GraphDMLPropertyItem
              | |     | | +-property_name="edgeLabelCol"
              | |     | | +-property=edgeLabelCol(STRING)
              | |     | | +-property_value=
              | |     | |   +-Literal(type=STRING, value="CustomEdge")
              | |     | +-GraphDMLPropertyItem
              | |     |   +-property_name="edgeJsonProp"
              | |     |   +-property=edgeJsonProp(JSON)
              | |     |   +-property_value=
              | |     |     +-Literal(type=JSON, value={"b":2}, has_explicit_type=TRUE)
              | |     +-label_list=
              | |     | +-GraphLabel
              | |     |   +-label=aml_dynamic.CONNECTION
              | |     |   +-label_name=
              | |     |     +-Literal(type=STRING, value="Connection", has_explicit_type=TRUE)
              | |     +-source_node=
              | |     | +-ColumnRef(type=GRAPH_NODE(aml_dynamic)<code INT64, id INT64, nodeJsonProp JSON, nodeLabelCol STRING, DYNAMIC>, column=$element_table.p#1)
              | |     +-dest_node=
              | |     | +-ColumnRef(type=GRAPH_NODE(aml_dynamic)<code INT64, id INT64, nodeJsonProp JSON, nodeLabelCol STRING, DYNAMIC>, column=$element_table.q#2)
              | |     +-element_table=DynamicGraphEdge
              | +-path_element_list=$element_table.[p#1, e#3, q#2]
              +-FinishScan
                +-input_scan=
                  +-GraphRefScan(column_list=$element_table.[p#1, q#2])
==

