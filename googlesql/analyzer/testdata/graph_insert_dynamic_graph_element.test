[default language_features=NONE,+SQL_GRAPH,+SQL_GRAPH_ADVANCED_QUERY,+SQL_GRAPH_RETURN_EXTENSIONS,+SQL_GRAPH_TERMINAL_INSERT,+SQL_GRAPH_DYNAMIC_ELEMENT_TYPE,+SQL_GRAPH_DYNAMIC_LABEL_PROPERTIES_IN_DDL,+JSON_TYPE]
[default no_run_sqlbuilder]

[language_features=NONE,+SQL_GRAPH,+SQL_GRAPH_ADVANCED_QUERY,+SQL_GRAPH_RETURN_EXTENSIONS,+SQL_GRAPH_TERMINAL_INSERT]
# Dynamic graph: Insert dynamic graph element with dynamic element language feature disabled yields error
GRAPH aml_dynamic
INSERT (n:Person {code: 1, id: 1})
--
ERROR: Dynamic label is not supported [at 2:7]
GRAPH aml_dynamic
      ^
==

#######################################################
# INSERT property writability
#######################################################

# Dynamic graph: Insert with dynamic properties on read-only dynamic properties backing column yields error
GRAPH aml_dynamic_read_only
INSERT (n:Entity {name: "Alice"})
--
ERROR: Cannot insert dynamic property 'name' because the dynamic properties backing column 'nodeJsonProp' is read-only [at 2:19]
INSERT (n:Entity {name: "Alice"})
                  ^
==

[language_features=NONE,+SQL_GRAPH,+SQL_GRAPH_ADVANCED_QUERY,+SQL_GRAPH_RETURN_EXTENSIONS,+SQL_GRAPH_TERMINAL_INSERT,+SQL_GRAPH_DYNAMIC_ELEMENT_TYPE,+SQL_GRAPH_DYNAMIC_LABEL_PROPERTIES_IN_DDL,+JSON_TYPE,+MAP_TYPE]
# Dynamic graph: Insert dynamic property with value type that does not support
# JSON conversion yields error
GRAPH aml_dynamic
INSERT (n:Entity {
  id: 1,
  dyn_prop:
  {{MAP_FROM_ARRAY([('k', 1)])|STRUCT(1 AS a, MAP_FROM_ARRAY([('k', 1)]) AS m)}}
})
--
ALTERNATION GROUP: MAP_FROM_ARRAY([('k', 1)])
--
ERROR: Cannot insert value of type MAP<STRING, INT64> into dynamic property 'dyn_prop': MAP<STRING, INT64> does not support conversion to JSON [at 7:3]
  MAP_FROM_ARRAY([('k', 1)])
  ^
--
ALTERNATION GROUP: STRUCT(1 AS a, MAP_FROM_ARRAY([('k', 1)]) AS m)
--
ERROR: Cannot insert value of type STRUCT<a INT64, m MAP<STRING, INT64>> into dynamic property 'dyn_prop': MAP<STRING, INT64> does not support conversion to JSON [at 7:3]
  STRUCT(1 AS a, MAP_FROM_ARRAY([('k', 1)]) AS m)
  ^
==

[language_features=NONE,+SQL_GRAPH,+SQL_GRAPH_ADVANCED_QUERY,+SQL_GRAPH_RETURN_EXTENSIONS,+SQL_GRAPH_TERMINAL_INSERT,+SQL_GRAPH_DYNAMIC_ELEMENT_TYPE,+SQL_GRAPH_DYNAMIC_LABEL_PROPERTIES_IN_DDL,+JSON_TYPE,+MAP_TYPE]
