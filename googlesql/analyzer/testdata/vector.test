####################################
# SET Operation and Recursive Scan #
####################################

# Set operation with matching vector dims annotations.
SELECT ENCODE_VECTOR([1.0, 2.0], 2, "FLOAT32") AS v
UNION ALL
SELECT ENCODE_VECTOR([3.0, 4.0], 2, "FLOAT32") AS v
--
QueryStmt
+-output_column_list=
| +-$union_all.v#3{VectorDims:2, VectorEncoding:"FLOAT32"} AS v [VECTOR]
+-query=
  +-SetOperationScan
    +-column_list=[$union_all.v#3{VectorDims:2, VectorEncoding:"FLOAT32"}]
    +-op_type=UNION_ALL
    +-input_item_list=
      +-SetOperationItem
      | +-scan=
      | | +-ProjectScan
      | |   +-column_list=[$union_all1.v#1{VectorDims:2, VectorEncoding:"FLOAT32"}]
      | |   +-expr_list=
      | |   | +-v#1 :=
      | |   |   +-FunctionCall(GoogleSQL:encode_vector(ARRAY<FLOAT>, optional(1) INT64, optional(1) STRING) -> VECTOR)
      | |   |     +-type_annotation_map={VectorDims:2, VectorEncoding:"FLOAT32"}
      | |   |     +-Literal(type=ARRAY<FLOAT>, value=[1, 2])
      | |   |     +-Literal(type=INT64, value=2)
      | |   |     +-Literal(type=STRING, value="FLOAT32")
      | |   +-input_scan=
      | |     +-SingleRowScan
      | +-output_column_list=[$union_all1.v#1{VectorDims:2, VectorEncoding:"FLOAT32"}]
      +-SetOperationItem
        +-scan=
        | +-ProjectScan
        |   +-column_list=[$union_all2.v#2{VectorDims:2, VectorEncoding:"FLOAT32"}]
        |   +-expr_list=
        |   | +-v#2 :=
        |   |   +-FunctionCall(GoogleSQL:encode_vector(ARRAY<FLOAT>, optional(1) INT64, optional(1) STRING) -> VECTOR)
        |   |     +-type_annotation_map={VectorDims:2, VectorEncoding:"FLOAT32"}
        |   |     +-Literal(type=ARRAY<FLOAT>, value=[3, 4])
        |   |     +-Literal(type=INT64, value=2)
        |   |     +-Literal(type=STRING, value="FLOAT32")
        |   +-input_scan=
        |     +-SingleRowScan
        +-output_column_list=[$union_all2.v#2{VectorDims:2, VectorEncoding:"FLOAT32"}]
==

