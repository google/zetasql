# Simple TYPEOF with a VECTOR.
[enabled_ast_rewrites=DEFAULTS]
SELECT TYPEOF(ENCODE_VECTOR([1.0, 2.0]))
--
QueryStmt
+-output_column_list=
| +-$query.$col1#1 AS `$col1` [STRING]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#1]
