# Testing multi-element ARRAY<VECTOR> with conflicting dims ensuring third element cannot revive dims.
SELECT
  [ENCODE_VECTOR([1.0], 2, "FLOAT32"), ENCODE_VECTOR([1.0], 3, "FLOAT32"), ENCODE_VECTOR([1.0], 4, "FLOAT32")]
--
QueryStmt
+-output_column_list=
| +-$query.$col1#1<{VectorDims:-1, VectorEncoding:"FLOAT32"}> AS `$col1` [ARRAY<VECTOR>]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#1<{VectorDims:-1, VectorEncoding:"FLOAT32"}>]
    +-expr_list=
    | +-$col1#1 :=
    |   +-FunctionCall(GoogleSQL:$make_array(repeated(3) VECTOR) -> ARRAY<VECTOR>)
    |     +-type_annotation_map=<{VectorDims:-1, VectorEncoding:"FLOAT32"}>
    |     +-FunctionCall(GoogleSQL:encode_vector(ARRAY<FLOAT>, optional(1) INT64, optional(1) STRING) -> VECTOR)
    |     | +-type_annotation_map={VectorDims:2, VectorEncoding:"FLOAT32"}
    |     | +-Literal(type=ARRAY<FLOAT>, value=[1])
    |     | +-Literal(type=INT64, value=2)
    |     | +-Literal(type=STRING, value="FLOAT32")
    |     +-FunctionCall(GoogleSQL:encode_vector(ARRAY<FLOAT>, optional(1) INT64, optional(1) STRING) -> VECTOR)
    |     | +-type_annotation_map={VectorDims:3, VectorEncoding:"FLOAT32"}
    |     | +-Literal(type=ARRAY<FLOAT>, value=[1])
    |     | +-Literal(type=INT64, value=3)
    |     | +-Literal(type=STRING, value="FLOAT32")
    |     +-FunctionCall(GoogleSQL:encode_vector(ARRAY<FLOAT>, optional(1) INT64, optional(1) STRING) -> VECTOR)
    |       +-type_annotation_map={VectorDims:4, VectorEncoding:"FLOAT32"}
    |       +-Literal(type=ARRAY<FLOAT>, value=[1])
    |       +-Literal(type=INT64, value=4)
    |       +-Literal(type=STRING, value="FLOAT32")
