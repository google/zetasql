    | +-$col1#1 :=
    |   +-FunctionCall(GoogleSQL:typeof(VECTOR) -> STRING)
    |     +-FunctionCall(GoogleSQL:encode_vector(ARRAY<FLOAT>, optional(0) INT64, optional(0) STRING) -> VECTOR)
    |       +-type_annotation_map={VectorDims:2, VectorEncoding:"FLOAT32"}
    |       +-Literal(type=ARRAY<FLOAT>, value=[1, 2])
    +-input_scan=
      +-SingleRowScan

[REWRITTEN AST]
QueryStmt
+-output_column_list=
| +-$query.$col1#1 AS `$col1` [STRING]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#1]
    +-expr_list=
    | +-$col1#1 :=
    |   +-FunctionCall(GoogleSQL:if(BOOL, STRING, STRING) -> STRING)
    |     +-Literal(type=BOOL, value=true, has_explicit_type=TRUE)
    |     +-Literal(type=STRING, value="VECTOR", has_explicit_type=TRUE)
    |     +-Cast(BOOL -> STRING)
    |       +-FunctionCall(GoogleSQL:$is_null(VECTOR) -> BOOL)
    |         +-FunctionCall(GoogleSQL:encode_vector(ARRAY<FLOAT>, optional(0) INT64, optional(0) STRING) -> VECTOR)
    |           +-type_annotation_map={VectorDims:2, VectorEncoding:"FLOAT32"}
    |           +-Literal(type=ARRAY<FLOAT>, value=[1, 2])
    +-input_scan=
      +-SingleRowScan
==

