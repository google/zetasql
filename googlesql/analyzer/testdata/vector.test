==

####################
# Query Parameters #
####################

# Declared named VECTOR parameters are assigned unconstrained dims and
# encoding, including VECTOR slots nested in ARRAY and STRUCT.
SELECT @test_param_vector, @test_param_array_vector, @test_param_struct_vector
--
QueryStmt
+-output_column_list=
| +-$query.$col1#1{VectorDims:-1, VectorEncoding:"UNCONSTRAINED"} AS `$col1` [VECTOR]
| +-$query.$col2#2<{VectorDims:-1, VectorEncoding:"UNCONSTRAINED"}> AS `$col2` [ARRAY<VECTOR>]
| +-$query.$col3#3<{VectorDims:-1, VectorEncoding:"UNCONSTRAINED"},_> AS `$col3` [STRUCT<v VECTOR, i INT64>]
+-query=
  +-ProjectScan
    +-column_list=$query.[$col1#1, $col2#2, $col3#3]
    +-expr_list=
    | +-$col1#1 := Parameter(type=VECTOR, type_annotation_map={VectorDims:-1, VectorEncoding:"UNCONSTRAINED"}, name="test_param_vector")
    | +-$col2#2 := Parameter(type=ARRAY<VECTOR>, type_annotation_map=<{VectorDims:-1, VectorEncoding:"UNCONSTRAINED"}>, name="test_param_array_vector")
    | +-$col3#3 := Parameter(type=STRUCT<v VECTOR, i INT64>, type_annotation_map=<{VectorDims:-1, VectorEncoding:"UNCONSTRAINED"},_>, name="test_param_struct_vector")
    +-input_scan=
      +-SingleRowScan
==

# Casting a declared named VECTOR parameter to a parameterized VECTOR type
# asserts the target dims and encoding.
SELECT CAST(@test_param_vector AS VECTOR(2, "FLOAT32"))
--
QueryStmt
+-output_column_list=
| +-$query.$col1#1{VectorDims:2, VectorEncoding:"FLOAT32"} AS `$col1` [VECTOR]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#1{VectorDims:2, VectorEncoding:"FLOAT32"}]
    +-expr_list=
    | +-$col1#1 :=
    |   +-Cast(VECTOR -> VECTOR)
    |     +-type_annotation_map={VectorDims:2, VectorEncoding:"FLOAT32"}
    |     +-Parameter(type=VECTOR, type_annotation_map={VectorDims:-1, VectorEncoding:"UNCONSTRAINED"}, name="test_param_vector")
    |     +-type_modifiers=type_parameters:(dims=2, encoding=FLOAT32)
    +-input_scan=
      +-SingleRowScan
==

# Mixing a declared named VECTOR parameter with an annotated VECTOR yields
# unconstrained.
SELECT {{IF(true, @test_param_vector, ENCODE_VECTOR([1.0, 2.0], 2, "FLOAT32"))|[@test_param_vector, ENCODE_VECTOR([1.0, 2.0], 2, "FLOAT32")]|[ENCODE_VECTOR([1.0, 2.0], 2, "FLOAT32"), @test_param_vector]}}
--
ALTERNATION GROUP: IF(true, @test_param_vector, ENCODE_VECTOR([1.0, 2.0], 2, "FLOAT32"))
--
QueryStmt
+-output_column_list=
| +-$query.$col1#1{VectorDims:-1, VectorEncoding:"UNCONSTRAINED"} AS `$col1` [VECTOR]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#1{VectorDims:-1, VectorEncoding:"UNCONSTRAINED"}]
    +-expr_list=
    | +-$col1#1 :=
    |   +-FunctionCall(GoogleSQL:if(BOOL, VECTOR, VECTOR) -> VECTOR)
    |     +-type_annotation_map={VectorDims:-1, VectorEncoding:"UNCONSTRAINED"}
    |     +-Literal(type=BOOL, value=true)
    |     +-Parameter(type=VECTOR, type_annotation_map={VectorDims:-1, VectorEncoding:"UNCONSTRAINED"}, name="test_param_vector")
    |     +-FunctionCall(GoogleSQL:encode_vector(ARRAY<FLOAT>, optional(1) INT64, optional(1) STRING) -> VECTOR)
    |       +-type_annotation_map={VectorDims:2, VectorEncoding:"FLOAT32"}
    |       +-Literal(type=ARRAY<FLOAT>, value=[1, 2])
    |       +-Literal(type=INT64, value=2)
    |       +-Literal(type=STRING, value="FLOAT32")
    +-input_scan=
      +-SingleRowScan
--
ALTERNATION GROUP: [@test_param_vector, ENCODE_VECTOR([1.0, 2.0], 2, "FLOAT32")]
--
QueryStmt
+-output_column_list=
| +-$query.$col1#1<{VectorDims:-1, VectorEncoding:"UNCONSTRAINED"}> AS `$col1` [ARRAY<VECTOR>]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#1<{VectorDims:-1, VectorEncoding:"UNCONSTRAINED"}>]
    +-expr_list=
    | +-$col1#1 :=
    |   +-FunctionCall(GoogleSQL:$make_array(repeated(2) VECTOR) -> ARRAY<VECTOR>)
    |     +-type_annotation_map=<{VectorDims:-1, VectorEncoding:"UNCONSTRAINED"}>
    |     +-Parameter(type=VECTOR, type_annotation_map={VectorDims:-1, VectorEncoding:"UNCONSTRAINED"}, name="test_param_vector")
    |     +-FunctionCall(GoogleSQL:encode_vector(ARRAY<FLOAT>, optional(1) INT64, optional(1) STRING) -> VECTOR)
    |       +-type_annotation_map={VectorDims:2, VectorEncoding:"FLOAT32"}
    |       +-Literal(type=ARRAY<FLOAT>, value=[1, 2])
    |       +-Literal(type=INT64, value=2)
    |       +-Literal(type=STRING, value="FLOAT32")
    +-input_scan=
      +-SingleRowScan
--
ALTERNATION GROUP: [ENCODE_VECTOR([1.0, 2.0], 2, "FLOAT32"), @test_param_vector]
--
QueryStmt
+-output_column_list=
| +-$query.$col1#1<{VectorDims:-1, VectorEncoding:"UNCONSTRAINED"}> AS `$col1` [ARRAY<VECTOR>]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#1<{VectorDims:-1, VectorEncoding:"UNCONSTRAINED"}>]
    +-expr_list=
    | +-$col1#1 :=
    |   +-FunctionCall(GoogleSQL:$make_array(repeated(2) VECTOR) -> ARRAY<VECTOR>)
    |     +-type_annotation_map=<{VectorDims:-1, VectorEncoding:"UNCONSTRAINED"}>
    |     +-FunctionCall(GoogleSQL:encode_vector(ARRAY<FLOAT>, optional(1) INT64, optional(1) STRING) -> VECTOR)
    |     | +-type_annotation_map={VectorDims:2, VectorEncoding:"FLOAT32"}
    |     | +-Literal(type=ARRAY<FLOAT>, value=[1, 2])
