      +-SingleRowScan
==

# Testing merging ARRAY<VECTOR> with the same dims and encoding.
SELECT
  [ENCODE_VECTOR([1.0, 2.0], 100, "FLOAT32"), ENCODE_VECTOR([1.0, 2.0], 100, "FLOAT32")]
--
QueryStmt
+-output_column_list=
| +-$query.$col1#1<{VectorDims:100, VectorEncoding:"FLOAT32"}> AS `$col1` [ARRAY<VECTOR>]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#1<{VectorDims:100, VectorEncoding:"FLOAT32"}>]
    +-expr_list=
    | +-$col1#1 :=
