# Table with generated column of VECTOR
[no_enable_literal_replacement]
CREATE TABLE t(arr ARRAY<FLOAT>, v VECTOR(4, 'FLOAT32') AS (ENCODE_VECTOR(arr, 4, 'FLOAT32')))
