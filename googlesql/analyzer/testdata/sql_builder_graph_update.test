GRAPH aml_dynamic
MATCH (n:Entity)
REMOVE n.dynamic_property1
--
[SQLBUILDER_TARGET_SYNTAX_MODE standard]
[SQLBUILDER_OUTPUT]
GRAPH aml_dynamic
MATCH
  (a_1 IS Entity)
REMOVE
  a_1.dynamic_property1;

[SQLBUILDER_TARGET_SYNTAX_MODE pipe]
[SQLBUILDER_OUTPUT]
GRAPH aml_dynamic
MATCH
  (a_1 IS Entity)
REMOVE
