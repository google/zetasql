# SET all properties on dynamic graph
GRAPH aml_dynamic
MATCH (n:Entity)
SET n = {code: 2000, new_dyn: "B"}
--
[SQLBUILDER_TARGET_SYNTAX_MODE standard]
[SQLBUILDER_OUTPUT]
GRAPH aml_dynamic
MATCH
  (a_1 IS Entity)
SET
  a_1 = { code : 2000, new_dyn : "B" };

[SQLBUILDER_TARGET_SYNTAX_MODE pipe]
[SQLBUILDER_OUTPUT]
GRAPH aml_dynamic
MATCH
  (a_1 IS Entity)
SET
  a_1 = { code : 2000, new_dyn : "B" };
==

# Combining property item and label item on the same variable in SET
GRAPH aml_dynamic
MATCH (n:Entity)
SET n:Vip, n.code = 2000, n.dynamic_property1 = "active"
--
[SQLBUILDER_TARGET_SYNTAX_MODE standard]
[SQLBUILDER_OUTPUT]
GRAPH aml_dynamic
MATCH
  (a_1 IS Entity)
SET
  a_1.code = 2000,
  a_1.dynamic_property1 = "active",
  a_1 IS Vip;

[SQLBUILDER_TARGET_SYNTAX_MODE pipe]
[SQLBUILDER_OUTPUT]
GRAPH aml_dynamic
MATCH
  (a_1 IS Entity)
SET
  a_1.code = 2000,
  a_1.dynamic_property1 = "active",
  a_1 IS Vip;
==

# Combining property item, property specification item, and label item in one SET clause
GRAPH aml_dynamic
MATCH (n:Entity), (m:Entity)
SET n:Vip, n = {code: 2000}, m.dynamic_property1 = "active"
--
[SQLBUILDER_TARGET_SYNTAX_MODE standard]
[SQLBUILDER_OUTPUT]
GRAPH aml_dynamic
MATCH
  (a_1 IS Entity),
  (a_2 IS Entity)
SET
  a_1 = { code : 2000 },
  a_1 IS Vip,
  a_2.dynamic_property1 = "active";

[SQLBUILDER_TARGET_SYNTAX_MODE pipe]
[SQLBUILDER_OUTPUT]
GRAPH aml_dynamic
MATCH
  (a_1 IS Entity),
  (a_2 IS Entity)
SET
  a_1 = { code : 2000 },
  a_1 IS Vip,
  a_2.dynamic_property1 = "active";
==

# Combining property item and label item in one REMOVE clause
GRAPH aml_dynamic
MATCH (n:Entity), (m:Entity)
REMOVE n:Vip, n.dynamic_property1, m.other_flag
--
[SQLBUILDER_TARGET_SYNTAX_MODE standard]
[SQLBUILDER_OUTPUT]
GRAPH aml_dynamic
MATCH
  (a_1 IS Entity),
  (a_2 IS Entity)
REMOVE
  a_1.dynamic_property1,
  a_1 IS Vip,
  a_2.other_flag;

[SQLBUILDER_TARGET_SYNTAX_MODE pipe]
[SQLBUILDER_OUTPUT]
GRAPH aml_dynamic
MATCH
  (a_1 IS Entity),
  (a_2 IS Entity)
REMOVE
  a_1.dynamic_property1,
  a_1 IS Vip,
  a_2.other_flag;
==

[language_features=NONE,+SQL_GRAPH,+SQL_GRAPH_ADVANCED_QUERY,+SQL_GRAPH_RETURN_EXTENSIONS,+SQL_GRAPH_TERMINAL_NON_RETURNING_UPDATE,+SQL_GRAPH_DYNAMIC_ELEMENT_TYPE,+SQL_GRAPH_DYNAMIC_LABEL_PROPERTIES_IN_DDL,+JSON_TYPE,+SQL_GRAPH_BOUNDED_PATH_QUANTIFICATION]
# SET on element unnested via FOR loop from quantified path pattern
GRAPH aml_dynamic
MATCH ((a:Entity)-[b:Transfer]->(c:Entity)){1, 3}
FOR element IN b
SET element.dynamic_property1 = JSON '"active"'
--
[SQLBUILDER_TARGET_SYNTAX_MODE standard]
[SQLBUILDER_OUTPUT]
GRAPH aml_dynamic
MATCH
  (
    (a_1 IS Entity)
    -[a_2 IS Transfer]->
    (a_3 IS Entity)
  ) { 1, 3 }
FOR a_4 IN a_2 WITH OFFSET AS a_5
SET
  a_4.dynamic_property1 = JSON '"active"';

[SQLBUILDER_TARGET_SYNTAX_MODE pipe]
[SQLBUILDER_OUTPUT]
GRAPH aml_dynamic
MATCH
  (
    (a_1 IS Entity)
    -[a_2 IS Transfer]->
    (a_3 IS Entity)
  ) { 1, 3 }
FOR a_4 IN a_2 WITH OFFSET AS a_5
SET
  a_4.dynamic_property1 = JSON '"active"';
==

[language_features=NONE,+SQL_GRAPH,+SQL_GRAPH_ADVANCED_QUERY,+SQL_GRAPH_RETURN_EXTENSIONS,+SQL_GRAPH_TERMINAL_NON_RETURNING_UPDATE,+SQL_GRAPH_DYNAMIC_ELEMENT_TYPE,+SQL_GRAPH_DYNAMIC_LABEL_PROPERTIES_IN_DDL,+JSON_TYPE,+SQL_GRAPH_BOUNDED_PATH_QUANTIFICATION]
# REMOVE on element unnested via FOR loop from quantified path pattern
GRAPH aml_dynamic
MATCH ((a:Entity)-[b:Transfer]->(c:Entity)){1, 3}
FOR element IN b
REMOVE element.dynamic_property1
--
[SQLBUILDER_TARGET_SYNTAX_MODE standard]
[SQLBUILDER_OUTPUT]
GRAPH aml_dynamic
MATCH
  (
    (a_1 IS Entity)
    -[a_2 IS Transfer]->
    (a_3 IS Entity)
  ) { 1, 3 }
FOR a_4 IN a_2 WITH OFFSET AS a_5
REMOVE
  a_4.dynamic_property1;

[SQLBUILDER_TARGET_SYNTAX_MODE pipe]
[SQLBUILDER_OUTPUT]
GRAPH aml_dynamic
MATCH
  (
    (a_1 IS Entity)
    -[a_2 IS Transfer]->
    (a_3 IS Entity)
  ) { 1, 3 }
FOR a_4 IN a_2 WITH OFFSET AS a_5
REMOVE
  a_4.dynamic_property1;
