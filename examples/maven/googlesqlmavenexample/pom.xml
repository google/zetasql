<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.google.googlesqlmavenexample</groupId>
  <artifactId>googlesqlmavenexample</artifactId>
  <version>1.0-SNAPSHOT</version>

  <name>googlesqlmavenexample</name>
  <url>https://github.com/google/googlesql</url>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
    <googlesql.version>2026.10.3</googlesql.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.google.googlesql</groupId>
      <artifactId>googlesql-client</artifactId>
      <version>${googlesql.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.google.googlesql</groupId>
      <artifactId>googlesql-types</artifactId>
      <version>${googlesql.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.google.googlesql</groupId>
      <artifactId>googlesql-jni-channel</artifactId>
      <version>${googlesql.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.google.googlesql</groupId>
      <artifactId>googlesql-jni-channel-linux</artifactId>
      <version>${googlesql.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.google.googlesql</groupId>
      <artifactId>googlesql-jni-channel-darwin</artifactId>
      <version>${googlesql.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <version>4.33.5</version>
    </dependency>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java-util</artifactId>
      <version>4.33.5</version>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
